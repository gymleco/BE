# ══════════════════════════════════════════════════════════
#  gymleco / api  —  Spring Boot 3 / Java 17
#
#  복사:  cp .env.example .env
#  운영 서버에서는 이 파일 대신 AWS SSM Parameter Store 를 쓰거나,
#  서버에 직접 두는 경우 파일 권한을 600 으로 제한한다. (기획서 §12)
# ══════════════════════════════════════════════════════════

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ── PostgreSQL ─────────────────────────────────────────────
# 앱 전용 계정을 쓴다. DROP / CREATE / 슈퍼유저 권한을 주지 않는다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gymleco
POSTGRES_USER=gymleco_app
POSTGRES_PASSWORD=change-me

# ── 관리자 인증 ────────────────────────────────────────────
# 32바이트 이상.  생성:  openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# 토큰은 localStorage 가 아니라 HttpOnly 쿠키로 내려간다.
# 쿠키를 붙일 부모 도메인 — 운영: .gymleco.co.kr / 로컬: 비워둠
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# 로그인 시도 제한. 계정 전면 잠금은 관리자를 상시 차단하는 DoS 가 되므로
# IP 기준을 1차로 두고, 계정 기준은 지수 백오프로 완화한다.
LOGIN_MAX_ATTEMPTS_PER_IP=5
LOGIN_IP_LOCK_MINUTES=15

# ── 문의자 개인정보 컬럼 암호화 (기획서 §12) ────────────────
# 두 키는 서로 다른 값이어야 한다.
#   PII_ENCRYPTION_KEY   전화번호 AES-256 암호화 (랜덤 IV)
#   PII_BLIND_INDEX_KEY  정규화된 번호의 HMAC — 관리자 화면 검색용
#     ※ 검색을 위해 결정적 암호화를 쓰지 말 것. 블라인드 인덱스로 해결한다.
# 생성:  openssl rand -base64 32
PII_ENCRYPTION_KEY=change-me-32-byte-key-base64
PII_BLIND_INDEX_KEY=change-me-different-32-byte-key-base64

# 개인정보 보유기간 — 초과분은 배치가 자동 파기한다 (기획서 §14)
INQUIRY_RETENTION_DAYS=365

# ── 최초 관리자 계정 ───────────────────────────────────────
# 관리자가 하나도 없을 때만 1회 생성된다. 생성 후에는 무시된다.
# ★ 운영에서는 생성 직후 이 변수를 지우고 비밀번호를 바꿀 것.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── CORS ───────────────────────────────────────────────────
# 와일드카드(*) 금지. 쉼표로 구분한 명시적 화이트리스트.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── S3 / CloudFront ────────────────────────────────────────
AWS_REGION=ap-northeast-2
S3_BUCKET=
CDN_BASE_URL=

# 로컬 개발에서만 사용한다.
# 운영 EC2 는 IAM 역할로 접근하고 서버에 키를 두지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Next.js ISR 재검증 훅 ──────────────────────────────────
# CMS 저장 트랜잭션 커밋 후 호출한다.
# web/.env.local 의 REVALIDATE_TOKEN 과 같은 값이어야 한다.
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_TOKEN=change-me-generate-with-openssl-rand-hex-32

# ── 문의 접수 알림 ─────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
INQUIRY_NOTIFY_TO=
